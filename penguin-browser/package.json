{
  "name": "penguin-browser",
  "version": "1.0.0",
  "description": "A Linux-inspired desktop web browser built with Electron.",
  "main": "main.js",
  "author": "Penguin Browser contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.penguinbrowser.app",
    "productName": "Penguin Browser",
    "directories": { "output": "release" },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network;WebBrowser;"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
